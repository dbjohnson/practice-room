# Install as a user unit (~/.config/systemd/user/practice-room.service), then:
#   systemctl --user daemon-reload && systemctl --user enable --now practice-room
# `loginctl enable-linger $USER` starts user units at boot without a login.
# Point ExecStart at a node >= 22.12 that survives upgrades (not a version-pinned path).
[Unit]
Description=Practice Room authenticated web gateway
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
WorkingDirectory=/home/bryan/code/practice-room
ExecStart=/usr/bin/node --import tsx src/platform/serve.ts
Restart=always
RestartSec=5
TimeoutStopSec=20
UMask=0077
NoNewPrivileges=true
LimitCORE=0

[Install]
WantedBy=default.target
