{
  "name": "practice-room",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "start": "tsx src/platform/serve.ts",
    "workspace": "tsx src/platform/cli.ts",
    "workspace:adopt": "tsx src/platform/adopt.ts",
    "dev": "vite --host 0.0.0.0",
    "audio:build": "tsx src/audio/soundfont/prepare.ts",
    "sources:pdmx": "tsx src/server/sources/pdmxIndex.ts",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests",
    "format": "prettier --write src tests *.ts *.json *.html *.js",
    "format:check": "prettier --check src tests *.ts *.json *.html *.js",
    "check": "npm run lint && npm run format:check && npm run test:coverage && npm run build",
    "audio:import": "tsx src/audio/soundfont/importAssets.ts"
  },
  "prettier": {
    "singleQuote": true,
    "printWidth": 100
  },
  "dependencies": {
    "@coderline/alphatab": "^1.8.4",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "express": "^5.2.1",
    "http-proxy-3": "^2.0.1",
    "lucide-react": "^1.49.0",
    "openid-client": "^6.8.8",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@coderline/alphatab-vite": "^1.8.4",
    "@eslint/js": "^10.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "jsdom": "^26.1.0",
    "prettier": "^3.9.9",
    "rolldown": "1.2.11",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.1",
    "vitest": "^4.1.11"
  }
}
