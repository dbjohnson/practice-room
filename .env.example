# Server-only values. Never prefix credentials with VITE_.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Empty allowlists deny access. Use comma-separated verified Google addresses.
GOOGLE_ALLOWED_EMAILS=
DEV_ALLOWED_EMAILS=
# Register the callback derived from workspace.config.json's origin:
# https://practice.loomen.net/auth/google/callback
